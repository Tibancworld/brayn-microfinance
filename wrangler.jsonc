{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brayn-microfinance",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  // Tunnel/DNS account: bblessking@gmail.com (not Tibworld)
  "vars": {
    "APP_URL": "https://www.myprototype.work",
    "ADMIN_USERNAME": "admin"
  },
  "containers": [
    {
      "class_name": "BraynApp",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BRAYN_APP",
        "class_name": "BraynApp"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BraynApp"]
    }
  ]
}
